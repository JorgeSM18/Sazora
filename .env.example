# Copia este archivo como .env (no se sube al repositorio) y rellena la clave.
# Clave de la API de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo principal (opcional). Por defecto: gemini-3.8-flash
GEMINI_MODEL=
# Modelos de reserva, en orden, si el principal está saturado (opcional).
# Por defecto: gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_FALLBACK_MODELS=
# Puerto y dirección de escucha (opcional). Por defecto: 8787 en 127.0.0.1 (detrás del proxy HTTPS).
# HOST=0.0.0.0 para aceptar conexiones de la red directamente.
PORT=
HOST=
# Carpeta de la base de datos y de los PDF de los usuarios (opcional). Por defecto: ./server-data
SAZORA_DATA_DIR=
# Pon 1 cuando la app se sirva por HTTPS (cookie de sesión con Secure)
COOKIE_SECURE=
# Código de invitación para que alguien cree su cuenta desde la app (opcional, mínimo 12 caracteres).
# Sin él, el registro está desactivado y los usuarios se crean con: npm run usuario -- crear ...
SAZORA_CODIGO_REGISTRO=
